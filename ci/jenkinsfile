pipeline {
  agent {
    label 'agent1'
   }
  stages{
        stage("Clean Workspace") { 
            steps {
                cleanWs()
            }
        }

        stage("App Codeckeckout"){
            steps {
                git branch: "terraform", url:"https://github.com/prateekkumawat/jenkins-11-project-ci.git"
            }  
        }
        
        stage("Terraform init"){
          steps {
            dir('terraform/app1'){
                sh 'terraform init -input=false'
            }
          }
        }

        stage("Terraform plan"){
          steps {
            dir('terraform/app1'){
                sh '''
                terraform plan -out=tfplan
                terraform show -no-color tfplan > tfplan.txt
                '''
            }    
          }
        }
        
        stage('Approval for Apply') {
            steps {
                script {
                    try {
                        timeout(time: 10, unit: 'MINUTES') {
                            def userInput = input(
                                id: 'userApprove',
                                message: 'Do you want to proceed with Terraform Apply?',
                                ok: 'Approve',
                                parameters: [
                                    choice(
                                        name: 'Action',
                                        choices: ['Apply', 'Skip'],
                                        description: 'Choose whether to Apply or Skip deployment'
                                    )
                                ]
                            )
                            env.DEPLOY_ACTION = userInput
                            echo "User selected action: ${env.DEPLOY_ACTION}"
                        }
                    } catch (err) {
                        echo "No input received or aborted. Defaulting to SKIP."
                        env.DEPLOY_ACTION = 'Skip'
                    }
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression { env.DEPLOY_ACTION == 'Apply' }
            }
            steps {
                dir('terraform/app1') {
                    echo "User approved deployment — running Terraform Apply..."
                    sh 'terraform apply -auto-approve tfplan'
                }
            }
        }

        stage('Skip Deployment') {
            when {
                expression { env.DEPLOY_ACTION == 'Skip' }
            }
            steps {
                echo "Terraform Apply skipped by user choice or timeout."
            }
        }

        stage("Teams Notify") {
            steps {
                script {
                    withCredentials([string(credentialsId: 'teams-notify', variable: 'WEBHOOK_URL')]) {
                        sh """
                        curl -H 'Content-Type: application/json' \
                        -d '{
                        "@type": "MessageCard",
                        "@context": "http://schema.org/extensions",
                        "summary": "Jenkins job Build",
                        "themeColor": "00FF00",
                        "title": "Jenkins Job: ${env.JOB_NAME}",
                        "sections": [{
                            "facts": [
                                { "name": "🟢 **Status**", "value": "**SUCCESS ✅**" },
                                { "name": "🔢 **Build**", "value": "**#${env.BUILD_NUMBER}**" },
                                { "name": "🌿 **Branch / Tag**", "value": "**${env.GIT_BRANCH ?: params.GIT_REF}**" },
                                { "name": "🔢 **ImageName**", "value": "**prateekkumawat/jenkinsimage:${params.ImageTag}**" },
                                { "name": "🔗 **Build URL**", "value": "[**Open Build**](${env.BUILD_URL})" }
                            ],
                            "text": "🚀 **Build completed successfully!**"
                        }]
                        }' \
                        \$WEBHOOK_URL
                        """
                    }
                }
            }
        }
    }
}